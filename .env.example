# MLflow registry/tracking service used to resolve sentinelml-ids@champion.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Application prediction logging database.
# This must be separate from the MLflow metadata database.
# Host development mode uses the host-mapped PostgreSQL port.
SENTINELML_DATABASE_URL=postgresql+psycopg2://sentinelml_app:REPLACE_WITH_SECURE_PASSWORD@127.0.0.1:5434/sentinelml_app

# Optional Phase 4 -> Phase 5 reload notification.
# Leave unset to skip notification after promotion.
SENTINELML_SERVING_RELOAD_URL=http://127.0.0.1:8000/internal/reload
SENTINELML_SERVING_RELOAD_TIMEOUT_SECONDS=2

# Optional local operations-dashboard service URLs.
SENTINELML_MONITOR_STATUS_URL=http://127.0.0.1:9101/status
SENTINELML_RESILIENCE_STATUS_URL=http://127.0.0.1:9201/status
SENTINELML_OPS_TIMEOUT_SECONDS=2

# Docker Compose app PostgreSQL values.
# Docker API containers use app-postgres:5432 internally via docker/docker-compose.yml.
SENTINELML_APP_POSTGRES_USER=sentinelml_app
SENTINELML_APP_POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
SENTINELML_APP_POSTGRES_DB=sentinelml_app
